# Clio configuration. Locally: copy to .env. On Fly: flyctl secrets set NAME=value.

# Guards key minting and admin routes. Choose at install; setup.mjs generates one.
ADMIN_TOKEN=

# Password for the web UI (accepted as ?key=, cookie, or HTTP Basic, so it works
# in a FileMaker web viewer). Blank = UI is open. Machine routes (/v1) always
# require an API key regardless.
SITE_PASSWORD=

# Optional. Without it: no ask-the-logs chat, and pattern scans fall back to
# plain threshold warnings (still useful).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-fable-5

PORT=8080
# DATA_DIR=./data        # /data on Fly (the volume)
# MAX_BATCH=500          # max entries per POST /v1/log

# Watchdog (usage auditing for the database admin). All optional.
# ALERT_WEBHOOK=         # POST warn/critical scan findings here (Slack webhook, Comm bus, ...)
# CLIO_TZ_OFFSET=3       # hours from UTC for business-time math (Crete: 3)
# BUSINESS_HOURS=07-19   # local on-hours; activity outside is "off-hours"
# BUSINESS_DAYS=1-5      # 1-5 = Monday-Friday
# EXPORT_ROWS_THRESHOLD=1000  # payload {"rows": N} at/over this = big export
